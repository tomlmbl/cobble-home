<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred from one device to another.
  allowBackup="false" turns off cloud backup, but not always device-to-device transfer
  (developer.android.com, "Behavior changes: Apps targeting Android 12"): hence these rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
