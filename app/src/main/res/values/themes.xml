<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home is shown over the system wallpaper. -->
    <style name="Theme.Launcher" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>


    <!-- Settings: opaque window, background close to the Material 3 surface before Compose first draws. -->
    <style name="Theme.Launcher.Settings" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>
